# Enquiry form email delivery (SMTP).
#
# Copy to `.env.local` for development, and set the same variables in your
# hosting provider's dashboard for production. Without these the enquiry form
# returns an error to the customer instead of silently discarding the enquiry.

# --- Required ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- Optional ---
# 587 (STARTTLS, default) or 465 (implicit TLS).
SMTP_PORT=587
# Only set to force TLS mode; otherwise inferred from the port.
# SMTP_SECURE=true

# Envelope sender. Must be an address the SMTP account may send as.
# Defaults to SMTP_USER.
# ENQUIRY_FROM=contact@tripreservations.co.uk

# Where enquiries are delivered. Comma-separated for several recipients.
# Defaults to site.company.supportEmail in config/site.ts.
# ENQUIRY_TO=contact@tripreservations.co.uk


# --- Common provider settings ---
#
# Google Workspace   host smtp.gmail.com          port 587
#                    SMTP_PASSWORD must be an App Password, not the account
#                    password (requires 2-Step Verification on the account).
#
# Microsoft 365      host smtp.office365.com      port 587
#
# cPanel / shared    host mail.tripreservations.co.uk   port 465
#                    SMTP_USER is the full mailbox address.
#
# Resend             host smtp.resend.com         port 587   user: resend
#                    SMTP_PASSWORD is the API key.
#
# SendGrid           host smtp.sendgrid.net       port 587   user: apikey
#                    SMTP_PASSWORD is the API key.
